<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.shonmods.friction-review</string>
  <key>ProgramArguments</key><array><string>/usr/bin/python3</string><string>__MOD_DIR__/scripts/friction/scan.py</string></array>
  <key>StartCalendarInterval</key><dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>0</integer></dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>__HOME__/.claude/friction-review/run.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.claude/friction-review/run.log</string>
</dict></plist>
